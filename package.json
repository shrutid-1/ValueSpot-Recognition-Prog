{
  "name": "touchcore-valuespot",
  "private": true,
  "version": "1.0.0",
  "description": "Touchcore ValueSpot - Employee Recognition & Core Values Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "doctor": "node scripts/check-setup.mjs",
    "type-check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.seeders.json --noEmit && tsc -p tsconfig.setup.json --noEmit",
    "supabase:types": "npx supabase gen types typescript --local > src/lib/supabase-types.ts",
    "seed:dev": "tsx scripts/seeders/seed.ts",
    "seed": "tsx scripts/seeders/seed.ts",
    "seed:verify": "tsx scripts/seeders/verify.ts",
    "verify:search": "tsx scripts/verify/search-filter.ts",
    "verify:leaders": "tsx scripts/verify/leader-board.ts",
    "verify:routing": "tsx scripts/verify/approval-routing.ts",
    "verify:moderation": "tsx scripts/verify/moderation-security.ts",
    "verify:eligibility": "tsx scripts/verify/recognition-eligibility.ts",
    "verify:authorities": "tsx scripts/verify/approval-authorities.ts",
    "verify:reporting": "tsx scripts/verify/reporting.ts",
    "verify:store": "tsx scripts/verify/value-store.ts",
    "verify:journey": "tsx scripts/verify/journey-track.ts",
    "verify:audit": "tsx scripts/verify/audit-actions.ts",
    "verify:security": "tsx scripts/verify/security-hardening.ts",
    "verify:logic": "npm run verify:search && npm run verify:leaders && npm run verify:routing && npm run verify:moderation && npm run verify:eligibility && npm run verify:authorities && npm run verify:reporting && npm run verify:store && npm run verify:journey && npm run verify:audit && npm run verify:security",
    "setup": "tsx scripts/setup/index.ts",
    "setup:check": "tsx scripts/setup/index.ts --check",
    "db:migrate": "tsx scripts/setup/index.ts --migrate",
    "db:status": "npx supabase migration list",
    "db:verify": "tsx scripts/setup/index.ts --check",
    "predev": "tsx scripts/setup/index.ts --check --soft"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@supabase/supabase-js": "^2.39.7",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^0.2.1",
    "date-fns": "^3.3.1",
    "date-fns-tz": "^3.1.3",
    "file-saver": "^2.0.5",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.2",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.11.25",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.35",
    "supabase": "^2.118.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.4.2",
    "vite": "^5.1.6"
  }
}
