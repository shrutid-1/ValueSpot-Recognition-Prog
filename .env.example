# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Public API credentials (used by React/Vite frontend)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (SEEDING ONLY - NEVER expose to frontend)
# Only needed when running: npm run seed
# Get from Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Gemini API key (AI report insights)
# Used ONLY by the generate-report-insights Edge Function, which runs on
# Supabase's servers. Push it with:
#
#     supabase secrets set --env-file ./.env
#
# NEVER rename this to VITE_GEMINI_API_KEY. Vite compiles every VITE_-prefixed
# variable into the browser bundle, where anyone can read it and spend the quota.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
